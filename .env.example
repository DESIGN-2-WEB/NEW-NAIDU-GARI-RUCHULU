# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- required ---
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/<database-name>

# Signing key for login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a new key is generated on every restart and all staff are logged out.
JWT_SECRET_KEY=

# --- optional ---
# MONGO_DB_NAME=<database-name>   (only if it is not in MONGO_URI)
# PORT=5000
# HOST=0.0.0.0
# Debug mode is off unless set here. Turn it on only on a developer's own
# computer - never where the internet can reach the server.
# DEBUG=false

# Which web addresses may call this API from a browser (comma-separated).
# Once the pages (Vercel) and the API are on different addresses, set this to
# the pages' address, e.g. https://pos.example.com
# CORS_ORIGINS=*

# How long a sign-in lasts.
# JWT_EXPIRY_DAYS=30
# Largest request the API accepts, in MB.
# MAX_UPLOAD_MB=8

# Local wall-clock offset. 330 = IST (+05:30). Drives "today" in the reports
# and the nightly reset of the bill number.
# TZ_OFFSET_MINUTES=330

# --- web pages (read when the pages are built, e.g. on Vercel) ---
# The API's address; leave empty when the pages and the API share one address
# (as on Vercel, where both run in one project).
# VITE_API_URL=https://api.example.com
# The pages' own address, for link previews. Not needed on Vercel (it knows
# its address); set it for a custom domain.
# SITE_URL=https://pos.example.com
